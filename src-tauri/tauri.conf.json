{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Vigil Tour Management Platform",
    "version":  "0.1.0",
    "identifier": "com.vigil.tourmanagement",
    "build":  {
                  "frontendDist":  "https://vigil-pos.vercel.app",
                  "devUrl":  "http://localhost:3000",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "Vigil Tour Management Platform",
                                    "width":  800,
                                    "height":  600,
                                    "resizable":  true,
                                    "fullscreen":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  "all",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.icns",
                                "icons/icon.ico"
                            ],
                   "android":  {
                                   "debugApplicationIdSuffix":  ".debug"
                               }
               }
}

